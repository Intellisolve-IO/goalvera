# Copy to infra/deploy.env (gitignored) and fill in. Every value can also be exported instead.
PROJECT_ID=my-gcp-project
REGION=us-east1
# BUCKET defaults to ${PROJECT_ID}-recordings
# BUCKET=my-recordings-bucket
REVIEW_DOMAIN=review.example.org
MATERIALS_MAIL_DOMAINS=staff.example
MAILER_SENDER_MAILBOX=notifications@example.org
# GITHUB_ISSUES_REPO=your-org/your-issues-repo
# OTA firmware bucket. Defaults to ${PROJECT_ID}-firmware.
# OTA_BUCKET=
# Private OTA signing key: Secret Manager secret $OTA_SIGNING_SECRET in $PROJECT_ID.
# The public half is already in firmware/recorder-idf/main/ota_pubkey.c.
# OTA_SIGNING_SECRET=recorder-ota-signing-key
# SCHOOL_PROFILE=everyday-heroes
# JOURNAL_DATASET=goalvera_journal
# JOURNAL_REPORTS_DATASET=goalvera_journal_reports
# PARENT_EMAIL_REDIRECT_DOMAIN=staff.example
# MAILER_FROM=notifications@example.org
